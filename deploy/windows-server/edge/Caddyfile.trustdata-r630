# Edge VM (192.168.1.241) for the Trust Data R630: every subdomain on public IP 98.97.76.237.
# Apply with:  sudo bash install-edge.sh Caddyfile.trustdata-r630
# The router is switched to forward 80/443 here only AFTER this file serves every site.

{
	email team@trustdata.ng
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}

# TrustData CyberWatch VM
cyberwatch.trustdata.ng {
	import common
	reverse_proxy 192.168.1.242:8080 {
		header_up X-Forwarded-Proto {scheme}
	}
}

