# TrustData CyberWatch configuration. Copy to .env and replace EVERY placeholder.
# Never commit a real .env file.

# ---- Environment -----------------------------------------------------------
CW_ENVIRONMENT=production            # development | test | demo | staging | production
CW_DEBUG=false
CW_PUBLIC_BASE_URL=https://cyberwatch.example.com
CW_COOKIE_SECURE=true
CW_COOKIE_DOMAIN=
CW_CORS_ORIGINS=[]                   # JSON list; empty when the SPA is served from the same origin
CW_REQUIRE_PLATFORM_MFA=true

# ---- Database and Redis (used by docker-compose) ---------------------------
POSTGRES_USER=cyberwatch
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=cyberwatch
REDIS_PASSWORD=CHANGE_ME_long_random_password

# ---- Credential encryption -------------------------------------------------
# Generate with: docker compose run --rm api python -m app.cli generate-key k1
# Format: key_id:base64(32 bytes). First key encrypts; all listed keys decrypt.
# Store this outside the database (secret manager or protected env file) and back it up separately.
CW_CREDENTIAL_KEYS=CHANGE_ME

# ---- Outbound policy (SSRF protection) --------------------------------------
# Must stay empty in production. Development only: e.g. ["127.0.0.0/8"]
CW_OUTBOUND_ALLOW_CIDRS=[]
CW_ALLOWED_SFTP_PORTS=[22,2222]
CW_ALLOWED_CPANEL_PORTS=[2083]
CW_ALLOWED_HTTP_PORTS=[80,443,8080,8443]

# ---- Scan limits ------------------------------------------------------------
CW_SCAN_MAX_FILE_BYTES=26214400
CW_SCAN_MAX_TOTAL_BYTES=2147483648
CW_SCAN_MAX_FILES=200000
CW_SCAN_MAX_SECONDS=3600
CW_TENANT_MAX_CONCURRENT_JOBS=2
CW_MONITORING_CONCURRENCY=4

# ---- Email (SMTP) -----------------------------------------------------------
CW_SMTP_HOST=
CW_SMTP_PORT=587
CW_SMTP_USERNAME=
CW_SMTP_PASSWORD=
CW_SMTP_STARTTLS=true
CW_EMAIL_FROM="TrustData CyberWatch <no-reply@example.com>"

# ---- WhatsApp Business Platform (Cloud API) ---------------------------------
CW_WHATSAPP_API_VERSION=v21.0
CW_WHATSAPP_PHONE_NUMBER_ID=
CW_WHATSAPP_ACCESS_TOKEN=

# ---- Paystack -------------------------------------------------------------
# Use sk_test_... in staging. Leave empty to disable online checkout.
CW_PAYSTACK_SECRET_KEY=
CW_TRIAL_DAYS=14
CW_GRACE_PERIOD_DAYS=7

# ---- Web -------------------------------------------------------------------
CW_WEB_BIND=127.0.0.1
CW_WEB_PORT=8080
